generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STAFF
  TECHNICIAN
  MANAGER
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobCategory {
  HARDWARE
  SOFTWARE
  ACCESS
  FACILITIES
  OTHER
}

enum ActivityType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  role          Role
  avatarUrl     String?
  submittedJobs ServiceJob[]  @relation("JobRequester")
  assignedJobs  ServiceJob[]  @relation("JobAssignee")
  activities    JobActivity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ServiceJob {
  id           String        @id
  reference    String        @unique
  title        String
  description  String
  category     JobCategory
  priority     Priority
  status       JobStatus     @default(OPEN)
  requesterId  String
  requester    User          @relation("JobRequester", fields: [requesterId], references: [id])
  assigneeId   String?
  assignee     User?         @relation("JobAssignee", fields: [assigneeId], references: [id])
  slaDueAt     DateTime
  resolvedAt   DateTime?
  closedAt     DateTime?
  activities   JobActivity[]
  createdAt    DateTime
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([slaDueAt])
}

model JobActivity {
  id        String       @id
  jobId     String
  job       ServiceJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  type      ActivityType
  note      String?
  fromValue String?
  toValue   String?
  createdAt DateTime

  @@index([jobId, createdAt])
}
